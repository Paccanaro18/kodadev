# Copie para .env (que nunca vai para o Git) e preencha. Escreva os valores SEM aspas:
# o Spring lê este arquivo como está e não remove as aspas.

# --- Login com GitHub (crie em https://github.com/settings/developers) -------------------------------
# Callback do OAuth App: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Criptografia do token do GitHub guardado no banco -------------------------------------------------
# 32 bytes aleatórios em Base64. Para gerar: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Provedor de IA ------------------------------------------------------------------------------------
# falso  = tickets e dicas simulados, sem rede e sem custo (padrão, serve para desenvolver e testar)
# openai = qualquer endpoint compatível com a API da OpenAI, como o FreeLLMAPI local
KODA_IA_PROVEDOR=falso
# Só com o provedor openai. A URL precisa ser https, ou http em localhost.
KODA_IA_URL=
KODA_IA_CHAVE=
# No FreeLLMAPI use auto (ou auto:fast, que evita os modelos mais lentos).
KODA_IA_MODELO=

# --- Opcionais (os valores abaixo são os padrões) ------------------------------------------------------
# Quantos tickets cada pessoa pode gerar em 24 horas.
# KODA_DESAFIO_LIMITE_DIARIO=5
# Quantas dicas cada pessoa pode pedir em 24 horas.
# KODA_DICA_LIMITE_DIARIO=10
# Endereço em que o backend escuta. Em produção, use 0.0.0.0 atrás de um proxy.
# KODA_SERVIDOR_ENDERECO=127.0.0.1
# Cookie de sessão só por HTTPS. Em produção, defina como true.
# KODA_COOKIE_SEGURO=false
